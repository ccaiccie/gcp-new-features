# Copy this file to terraform.tfvars and fill in your own Google Cloud values.
# Never commit terraform.tfvars or any credentials to version control.

project_id        = "your-gcp-project-id"
use_project_scope = true
# If using organization-level NGFW resources instead, set use_project_scope = false
# and provide your numeric organization ID below:
# organization_id = "123456789012"

region = "us-central1"
zone   = "us-central1-a"
prefix = "urlf-lab"

allowed_domains = ["*example.com"]
denied_domains  = ["*example.org"]
